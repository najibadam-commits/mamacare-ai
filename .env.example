# Copy to .env  (docker compose reads it automatically). Nothing here is required.
MAMACARE_VERSION=0.1.0
WEB_PORT=80
WEB_TLS_PORT=443
# Set to true only after mounting certificates in ./deploy/certs (fullchain.pem, privkey.pem).
FORCE_HTTPS=false

# RAG engine
RAG_EMBEDDING_BACKEND=hash
RAG_MIN_RELEVANCE=0.12
# Optional external LLM (sends question text to the provider - see docs/PILOT.md before enabling)
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
