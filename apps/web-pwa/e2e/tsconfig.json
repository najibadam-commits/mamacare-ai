{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["./**/*.ts", "../playwright.config.ts", "../src/data/guides.seed.ts"]
}
